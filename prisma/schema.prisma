generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A signed-in person. `id` is the Google account's stable subject id.
model User {
  id        String    @id
  email     String?
  name      String?
  image     String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  // Signed-in owner. Null = legacy project from before accounts existed; never visible to anyone.
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoints   Endpoint[]
  logs        RequestLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
}

model Endpoint {
  id           String   @id @default(cuid())
  path         String
  method       String   // e.g. GET, POST, PUT, DELETE, PATCH
  responseBody String   @db.Text
  latencyMs    Int      @default(0)
  errorRate    Float    @default(0) // 0 to 1 (e.g., 0.1 for 10% errors)
  active       Boolean  @default(true)
  
  // Advanced Simulation Controls
  requireAuth      Boolean @default(false)
  customAuthHeader String? // Optional specific string, e.g. 'Bearer custom_token_123'
  enableCors       Boolean @default(true) // Should wildcard CORS headers be sent?

  // Response shaping
  statusCode       Int     @default(200)
  responseHeaders  String? @db.Text // JSON object of extra response headers
  errorStatusCode  Int?    // If set, simulated errors use this status instead of a random 5xx

  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, method, path])
}

model RequestLog {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpointId     String?
  method         String
  path           String
  statusCode     Int
  latencyMs      Int
  requestHeaders String   @db.Text // JSON
  queryParams    String   @db.Text // JSON
  requestBody    String?  @db.Text
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt])
}
